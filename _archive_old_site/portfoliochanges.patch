From 020272c32a1bbc87adbe6e493049138a4ba6106d Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Thu, 28 May 2026 07:55:31 +0000
Subject: [PATCH 2/2] Fix home page animations not showing on GitHub Pages

main.css has 'body.is-preload * { animation: none !important }' which kills
all CSS keyframe animations while the page loads. On slow networks (GitHub Pages)
the is-preload class lingers long enough that animations never start. Fix:
- Add DOMContentLoaded listener to remove is-preload immediately when HTML parses
  (instead of waiting for window.load like main.js does)
- Add specific !important overrides for floatIntro, scrollBounce, timelineDraw,
  and scaleIn so they run even if is-preload hasn't been removed yet
---
 index.html | 21 +++++++++++++++++++++
 1 file changed, 21 insertions(+)

diff --git a/index.html b/index.html
index d8ce4eb..3e1ef81 100644
--- a/index.html
+++ b/index.html
@@ -355,9 +355,30 @@
 				transform: none !important;
 				transition: none !important;
 			}
+		/* Allow keyframe animations to run immediately, overriding main.css's
+		   body.is-preload * { animation: none !important } rule */
+		body.is-preload #intro .inner {
+			animation: floatIntro 5s ease-in-out infinite !important;
+		}
+		body.is-preload #intro .scroll-down {
+			animation: scrollBounce 1.6s ease-in-out infinite !important;
+		}
+		body.is-preload .timeline-container::before {
+			animation: timelineDraw 1.4s ease-out !important;
+		}
+		body.is-preload .timeline-entry::before {
+			animation: scaleIn 0.6s ease forwards !important;
+		}
 		</style>
 	</head>
 	<body class="is-preload">
+	<script>
+		/* Remove is-preload at DOM ready so CSS animations start immediately,
+		   not after all network resources finish loading (window.load). */
+		document.addEventListener('DOMContentLoaded', function() {
+			document.body.classList.remove('is-preload', 'is-loading');
+		});
+	</script>
 
 		<!-- Wrapper -->
 			<div id="wrapper" class="fade-in">
